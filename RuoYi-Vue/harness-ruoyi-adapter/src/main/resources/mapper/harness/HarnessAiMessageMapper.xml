<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.harness.adapter.mapper.HarnessAiMessageMapper">
  <resultMap id="Message" type="com.ruoyi.harness.ai.model.AiStoredMessage">
    <id property="id" column="id"/><result property="sessionId" column="session_id"/><result property="role" column="role"/><result property="content" column="content"/><result property="scriptSnapshot" column="script_snapshot"/>
    <result property="model" column="model"/><result property="provider" column="provider"/><result property="inputTokens" column="input_tokens"/><result property="outputTokens" column="output_tokens"/><result property="createdAt" column="created_at"/>
  </resultMap>
  <select id="findBySessionId" resultMap="Message">select id,session_id,role,content,script_snapshot,model,provider,input_tokens,output_tokens,created_at from harness_ai_message where session_id=#{sessionId} order by id</select>
  <insert id="insert" parameterType="com.ruoyi.harness.ai.model.AiStoredMessage" useGeneratedKeys="true" keyProperty="id">insert into harness_ai_message(session_id,role,content,script_snapshot,model,provider,input_tokens,output_tokens,created_at) values(#{sessionId},#{role},#{content},#{scriptSnapshot},#{model},#{provider},#{inputTokens},#{outputTokens},#{createdAt})</insert>
</mapper>
