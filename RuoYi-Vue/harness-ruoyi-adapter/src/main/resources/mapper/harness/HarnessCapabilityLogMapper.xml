<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.harness.adapter.mapper.HarnessCapabilityLogMapper">
  <resultMap id="Log" type="com.ruoyi.harness.core.domain.CapabilityLog">
    <id property="id" column="id"/><result property="traceId" column="trace_id"/><result property="executionLogId" column="execution_log_id"/><result property="capabilityName" column="capability_name"/>
    <result property="capabilityVersion" column="capability_version"/><result property="userId" column="user_id"/><result property="riskLevel" column="risk_level"/><result property="status" column="status"/>
    <result property="elapsedMs" column="elapsed_ms"/><result property="errorCode" column="error_code"/><result property="createdAt" column="created_at"/>
  </resultMap>
  <insert id="insert" parameterType="com.ruoyi.harness.core.domain.CapabilityLog" useGeneratedKeys="true" keyProperty="id">
    insert into harness_capability_log(trace_id,execution_log_id,capability_name,capability_version,user_id,risk_level,status,elapsed_ms,error_code,created_at)
    values(#{traceId},#{executionLogId},#{capabilityName},#{capabilityVersion},#{userId},#{riskLevel},#{status},#{elapsedMs},#{errorCode},#{createdAt})
  </insert>
  <select id="search" resultMap="Log">select * from harness_capability_log <where>
    <if test="traceId != null and traceId != ''">and trace_id=#{traceId}</if><if test="capability != null and capability != ''">and capability_name=#{capability}</if>
    <if test="userId != null">and user_id=#{userId}</if><if test="status != null and status != ''">and status=#{status}</if><if test="from != null">and created_at &gt;=#{from}</if><if test="to != null">and created_at &lt;=#{to}</if>
  </where> order by id desc limit 1000</select>
</mapper>
